{
  "name": "rubezhanin-agency-agents-app",
  "version": "1.0.0",
  "description": "Agency Agents — a cross-platform installer for AI agent catalogs. Browse, install, and track the agent personas from rubezhanin/agency-agents across every supported AI coding tool, with a first-class Hermes plugin target and per-install backup/rollback.",
  "type": "module",
  "author": "Yuri Shvets",
  "homepage": "https://github.com/rubezhanin/agency-agents-app",
  "bugs": "https://github.com/rubezhanin/agency-agents-app/issues",
  "repository": "github:rubezhanin/agency-agents-app",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:phase-c": "tools/phase-c/phase-c.sh",
    "build:phase-c:full": "PHASE_C_INCLUDE_VMS=1 tools/phase-c/phase-c.sh",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@lucide/svelte": "^1.16.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^8.2.2"
  }
}
